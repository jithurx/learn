---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, date, tags, cover, coverAlt, subtitle, number } =
  project.data;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a
  href={`${base}projects/${project.id}/`}
  class="group not-prose flex flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-zinc-300 hover:shadow-xl hover:shadow-zinc-200/60 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700 dark:hover:shadow-black/40"
>
  {
    cover && (
      <div class="relative aspect-[16/9] overflow-hidden bg-zinc-100 dark:bg-zinc-800">
        <img
          src={cover}
          alt={coverAlt ?? title}
          loading="lazy"
          decoding="async"
          class="m-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
        />
        <span class="absolute top-4 left-4 rounded-full bg-white/90 px-3 py-1 text-[0.7rem] font-semibold tracking-widest text-zinc-700 uppercase shadow-sm backdrop-blur dark:bg-zinc-900/85 dark:text-zinc-200">
          {String(number).padStart(2, "0")}
        </span>
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <div
      class="mb-3 flex flex-wrap items-center gap-2 text-[0.7rem] font-medium tracking-wider text-zinc-500 uppercase dark:text-zinc-400"
    >
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {
        tags.slice(0, 3).map((tag) => (
          <span class="rounded-full border border-zinc-200 px-2 py-0.5 dark:border-zinc-700">
            {tag}
          </span>
        ))
      }
    </div>

    <h2
      class="m-0 text-2xl leading-tight font-semibold text-zinc-900 transition group-hover:text-blue-700 dark:text-zinc-50 dark:group-hover:text-blue-300"
    >
      {title}
    </h2>

    {subtitle && (
      <p class="mt-2 mb-0 text-sm leading-snug text-zinc-500 dark:text-zinc-400">
        {subtitle}
      </p>
    )}

    <p class="mt-4 mb-0 line-clamp-3 text-[0.95rem] leading-relaxed text-zinc-600 dark:text-zinc-300">
      {description}
    </p>

    <span
      class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-700 dark:text-blue-300"
    >
      Read project
      <span
        aria-hidden="true"
        class="transition-transform duration-300 group-hover:translate-x-1"
      >
        &rarr;
      </span>
    </span>
  </div>
</a>

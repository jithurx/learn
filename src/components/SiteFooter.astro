---
const year = new Date().getFullYear();
---

<footer class="mx-auto mt-20 max-w-[50rem] border-t border-zinc-200 px-6 py-8 text-sm text-zinc-600 dark:border-zinc-800 dark:text-zinc-400">
  <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
    <div class="flex items-center gap-3">
      <img
        src="https://github.com/jithurx.png?size=96"
        alt="Portrait of Abhijith R"
        width="36"
        height="36"
        loading="lazy"
        class="m-0 h-9 w-9 rounded-full border border-zinc-300 dark:border-zinc-700"
      />
      <p class="m-0">
        Made by <a href="https://github.com/jithurx" rel="me noopener">Abhijith R</a>
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
      <a href="https://github.com/jithurx/learn" rel="noopener">Source</a>
      <a href="https://research-template.roman.technology" rel="nofollow noopener">
        Project page template
      </a>
    </div>
  </div>
  <p class="mt-6 mb-0 text-center text-xs text-zinc-500 dark:text-zinc-500">
    Copyright &copy; {year} Abhijith R. Built with Astro and Tailwind CSS.
  </p>
</footer>

---
import { getCollection, render } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import Table from "@/components/Table.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const {
  title,
  subtitle,
  description,
  date,
  tags,
  cover,
  coverAlt,
  links,
} = project.data;

const authors = [
  {
    name: "Abhijith R",
    url: "https://github.com/jithurx",
    institution: "learn.jithurx.dev",
  },
];

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
---

<BaseLayout
  title={`${title} — Abhijith R`}
  description={description}
  thumbnail={cover}
>
  <main>
    <Header
      title={title}
      conference={subtitle}
      authors={authors}
      links={links}
    >
      {
        cover && (
          <img slot="background" src={cover} alt={coverAlt ?? ""} />
        )
      }
    </Header>

    <div
      class="not-prose mb-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400"
    >
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {
        tags.map((tag) => (
          <span class="rounded-full border border-zinc-300 px-3 py-0.5 text-xs font-medium tracking-wide dark:border-zinc-700">
            {tag}
          </span>
        ))
      }
    </div>

    <Content components={{ table: Table }} />

    <div class="not-prose mt-16">
      <a
        href={base}
        class="inline-flex items-center gap-2 text-sm font-semibold text-blue-700 dark:text-blue-300"
      >
        <span aria-hidden="true">&larr;</span> All projects
      </a>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
